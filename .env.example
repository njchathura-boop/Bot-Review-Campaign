APP_ENV=local
MODEL_PATH=artifacts/review_model.joblib
REVIEW_TRANSFORMER_PATH=artifacts/review_distilbert
CAMPAIGN_MODEL_PATH=artifacts/campaign_model
DATASET_VERSION=demo-data-v1
FEATURE_VERSION=feature-set-v2
GIT_COMMIT=local-uncommitted
IMAGE_DIGEST=local-development
DEPLOYMENT_REVISION=docker-compose-local
GRAFANA_URL=http://localhost:3000
MLFLOW_URL=http://localhost:5001
PROMETHEUS_URL=http://localhost:9090
KIBANA_URL=http://localhost:5601
RAY_DASHBOARD_URL=http://localhost:8265
SPARK_MASTER_UI_URL=http://localhost:8082/json/
CAMPAIGN_CANDIDATE_LIMIT=100
CAMPAIGN_ALERTS_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_RAW_REVIEWS_TOPIC=reviews.raw.v1
KAFKA_CAMPAIGN_SCORES_TOPIC=reviews.campaign-scores.v1
KAFKA_CAMPAIGN_ALERT_GROUP_ID=campaign-api-materializer-v1

# Training and orchestration. Use 1 GPU only after Ray reports an available GPU.
RAY_MAX_CONCURRENT_TRIALS=1
BOT_CAMPAIGN_GPUS_PER_TRIAL=0
BOT_CAMPAIGN_MAX_CONCURRENT_TRIALS=1
BOT_CAMPAIGN_RETRAIN_CRON=
